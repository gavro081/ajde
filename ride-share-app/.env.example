# Supabase -- Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# The public key. New projects issue `sb_publishable_...`; older ones issue a
# legacy `anon` JWT (eyJ...), which goes in NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# Either variable works -- see lib/supabase/env.ts.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS -- used by seed/admin scripts, never sent to the browser.
SUPABASE_SECRET_KEY=
# Legacy alternative for projects that have not created an sb_secret_ key yet.
SUPABASE_SERVICE_ROLE_KEY=

# Local-only escape hatch for Supabase email limits. Never enable in production.
DEV_AUTH_BYPASS=false

# Postgres, for psql and migrations. Use the Session pooler string (port 5432):
# the direct db.<ref>.supabase.co host is IPv6-only and will not resolve on
# most laptops or on Vercel's build machines.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Server-only calculator assumptions. Set these to the verified current pump prices before demoing.
FUEL_PRICE_PETROL_MKD_L=
FUEL_PRICE_DIESEL_MKD_L=

# Comma-separated, exact domains accepted by the server-side magic-link flow.
STUDENT_EMAIL_DOMAINS=students.finki.ukim.mk,student.finki.ukim.mk

# Server-only OpenAI credentials for location fallback and ride-post parsing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_LOCATION_MODEL=gpt-5-mini
OPENAI_SEARCH_MODEL=gpt-5.4-mini
